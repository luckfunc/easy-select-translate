{
  "name": "easy-select-translate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:content & npm run dev:popup",
    "dev:content": "vite build --config vite-content.config.ts --watch",
    "dev:popup": "vite build --watch",
    "build": "npm run build:content && npm run build:popup",
    "build:content": "vite build --config vite-content.config.ts",
    "build:popup": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome format --write . && biome check --write .",
    "lint:ci": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
